{
	"credential_issuer": "http://localhost:8080",
	"authorization_servers": ["http://localhost:8080"],
	"credential_endpoint": "http://localhost:8080/credentials",
	"deferred_credential_endpoint": "http://localhost:8080/deferred_credential",
	"nonce_endpoint": "http://localhost:8080/nonce",
	"credential_response_encryption": {
		"alg_values_supported": ["ECDH-ES"],
		"enc_values_supported": ["A128GCM"],
		"encryption_required": false
	},
	"display": [
		{
			"name": "VCKnots Community",
			"locale": "en-US"
		}
	],
	"credential_configurations_supported": {
		"VCKnotsUserMedal": {
			"format": "jwt_vc_json",
			"scope": "VCKnotsUser",
			"cryptographic_binding_methods_supported": ["did:key"],
			"credential_signing_alg_values_supported": ["ES256"],
			"credential_definition": {
				"type": ["VerifiableCredential", "VCKnotsUserMedal"]
			},
			"proof_types_supported": {
				"jwt": {
					"proof_signing_alg_values_supported": ["ES256"]
				}
			},
			"credential_metadata": {
				"display": [
					{
						"name": "VCKnots User Medal",
						"locale": "en-US",
						"background_color": "#d97706",
						"text_color": "#FFFFFF"
					}
				],
				"claims": [
					{
						"path": ["credentialSubject", "username"],
						"display": [
							{
								"name": "Username",
								"locale": "en-US"
							}
						],
						"mandatory": true
					},
					{
						"path": ["credentialSubject", "issued_at"],
						"display": [
							{
								"name": "Issued At",
								"locale": "en-US"
							}
						]
					},
					{
						"path": ["credentialSubject", "medal_type"],
						"display": [
							{
								"name": "Medal Type",
								"locale": "en-US"
							}
						]
					}
				]
			}
		}
	}
}
