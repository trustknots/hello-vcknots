# サーバーのベース URL とポート番号
# デフォルト: http://localhost:8080 / 8080
# BASE_URL=http://localhost:8080
# PORT=8080

# 設定ディレクトリのパス（メタデータ JSON・鍵ファイルのベースディレクトリ）
# デフォルト: issuer-verifier/config
# ISSUER_VERIFIER_CONFIG_DIR=/path/to/config

# 鍵ディレクトリのパス（ISSUER_VERIFIER_CONFIG_DIR/keys を個別に上書きしたい場合）
# デフォルト: {ISSUER_VERIFIER_CONFIG_DIR}/keys
# ISSUER_VERIFIER_KEY_DIR=/path/to/keys

# Verifier 秘密鍵・証明書ファイルのパス（個別に上書きしたい場合）
# デフォルト: {ISSUER_VERIFIER_KEY_DIR}/private_key_openid.pem
# VERIFIER_PRIVATE_KEY_PATH=/path/to/private_key_openid.pem
# デフォルト: {ISSUER_VERIFIER_KEY_DIR}/certificate_openid.pem
# VERIFIER_CERTIFICATE_PATH=/path/to/certificate_openid.pem
