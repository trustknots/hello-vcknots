# === Issuer サーバー設定 ===
# デフォルト: http://localhost:8080 / 8080
# ISSUER_BASE_URL=http://localhost:8080
# ISSUER_PORT=8080

# === Verifier サーバー設定 ===
# デフォルト: ISSUER_BASE_URL と同じ（同一ポート動作）
# 別ポートで起動する場合は以下を設定する（推奨: 8081）
# 注意: wallet (Go) は 8082 を使用するため競合しない
# VERIFIER_BASE_URL=http://localhost:8081
# VERIFIER_PORT=8081

# === 共通フォールバック ===
# ISSUER_BASE_URL / VERIFIER_BASE_URL が未設定の場合に使用される
# BASE_URL=http://localhost:8080
# PORT=8080

# === 設定ディレクトリ ===
# メタデータ JSON・鍵ファイルのベースディレクトリ
# デフォルト: issuer-verifier/config
# ISSUER_VERIFIER_CONFIG_DIR=/path/to/config

# 鍵ディレクトリ（ISSUER_VERIFIER_CONFIG_DIR/keys を個別に上書きしたい場合）
# デフォルト: {ISSUER_VERIFIER_CONFIG_DIR}/keys
# ISSUER_VERIFIER_KEY_DIR=/path/to/keys

# === Verifier 鍵・証明書 ===
# デフォルト: {ISSUER_VERIFIER_KEY_DIR}/private_key_openid.pem
# VERIFIER_PRIVATE_KEY_PATH=/path/to/private_key_openid.pem
# デフォルト: {ISSUER_VERIFIER_KEY_DIR}/certificate_openid.pem
# VERIFIER_CERTIFICATE_PATH=/path/to/certificate_openid.pem
