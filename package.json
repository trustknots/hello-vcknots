{
  "name": "hello-vcknots-root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "issuer-verifier"
  ],
  "scripts": {
    "setup": "pnpm --filter hello-vcknots-issuer-verifier run setup",
    "build": "pnpm build:issuer-verifier",
    "build:issuer-verifier": "pnpm --filter hello-vcknots-issuer-verifier build",
    "dev:server": "pnpm --filter hello-vcknots-issuer-verifier dev",
    "dev:wallet": "cd wallet && go run main.go",
    "dev": "concurrently \"pnpm dev:server\" \"pnpm dev:wallet\""
  },
  "devDependencies": {
    "@trustknots/vcknots": "0.8.0",
    "@types/node": "^24.0.0",
    "concurrently": "^8.2.2",
    "tsx": "^4.23.15"
  }
}
